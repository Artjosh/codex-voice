# Shared secret between wa-voice-bridge and codex-voice.
VOICE_TOKEN=change-me
# Numbers allowed to call the bot, digits with country code, comma separated (* = anyone).
# Numbers can also be allowed from the UI after a rejected call.
ALLOWED_CALLERS=
# Contacts the bot must never act on (calls are left ringing, never answered or declined).
# Phone numbers and/or LIDs, digits only, comma separated. Keep real numbers out of git.
PROTECTED_CALLERS=
WA_VOICE=cove
WA_IDLE_MINUTES=5
WA_MAX_CALL_MINUTES=60
